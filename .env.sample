# SwitchBot API credentials.
# Issue a token/secret from the SwitchBot app: Profile > Preferences > Developer Options.
TOKEN=xxxx
SECRET=xxxx
DEVICE_ID=xxxx

# Optional tuning (defaults shown).
# ONAIR_POLL_INTERVAL_SECS=1          # how often to poll camera usage
# ONAIR_DEBOUNCE=2                    # consecutive readings needed to confirm a change
# ONAIR_IGNORE_PROCESSES=pipewire,wireplumber  # process-name prefixes to ignore
# RUST_LOG=info                       # log level: error|warn|info|debug
